generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  displayName String?
  avatar      String?
  isOwner     Boolean  @default(false)
  isGuildMember Boolean @default(false)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  memberRoles MemberRole[]
  applications Application[]
  auditEvents AuditEvent[]
  requestedActions DiscordAction[]
  bio String? @db.VarChar(240)
  xp Int @default(0)
  level Int @default(1)
  giveawayEntries GiveawayEntry[]
  gameScores GameScore[]
  assignedTasks StaffTask[] @relation("TaskAssignee")
  createdTasks StaffTask[] @relation("TaskCreator")
  staffReports StaffReport[] @relation("ReportAuthor")
  achievements MemberAchievement[]
}

model MemberRole {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  discordRoleId String
  syncedAt    DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, guildId, discordRoleId])
  @@index([guildId, discordRoleId])
}

model RoleMapping {
  id             String   @id @default(cuid())
  guildId        String
  discordRoleId  String
  permission     String
  createdAt      DateTime @default(now())
  @@unique([guildId, discordRoleId, permission])
  @@index([guildId, permission])
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("staff")
  status      String   @default("submitted")
  answers     Json
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       ApplicationNote[]
  @@index([status, submittedAt])
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())
  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  subject   String?
  details   Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
}

model DiscordAction {
  id          String   @id @default(cuid())
  type        String
  payload     Json
  status      String   @default("queued")
  result      String?
  requestedBy String
  createdAt   DateTime @default(now())
  processedAt DateTime?
  requester   User     @relation(fields: [requestedBy], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}


model ModerationCase {
  id                String   @id @default(cuid())
  guildId           String
  targetDiscordId   String
  moderatorDiscordId String
  type              String
  reason            String
  durationSeconds   Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  expiresAt         DateTime?
  @@index([guildId, targetDiscordId, createdAt])
  @@index([guildId, type, createdAt])
}

model PortalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}


model PortalSession {
  sid    String   @id(map: "portal_sessions_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_session_expire")
  @@map("portal_sessions")
}

model PortalAnnouncement {
 id String @id @default(cuid())
 title String
 body String
 audience String @default("members")
 pinned Boolean @default(false)
 authorId String
 createdAt DateTime @default(now())
 @@index([audience, createdAt])
}
model CommunityEvent {
 id String @id @default(cuid())
 title String
 description String
 startsAt DateTime
 endsAt DateTime?
 visibility String @default("public")
 createdBy String
 createdAt DateTime @default(now())
 @@index([visibility, startsAt])
}
model Giveaway {
 id String @id @default(cuid())
 title String
 description String
 prize String
 endsAt DateTime
 status String @default("open")
 winnerId String?
 createdBy String
 createdAt DateTime @default(now())
 entries GiveawayEntry[]
 @@index([status, endsAt])
}
model GiveawayEntry {
 id String @id @default(cuid())
 giveawayId String
 userId String
 createdAt DateTime @default(now())
 giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([giveawayId, userId])
}
model GameScore {
 id String @id @default(cuid())
 userId String
 game String
 score Int
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([game, score])
}
model StaffTask {
 id String @id @default(cuid())
 title String
 description String
 status String @default("open")
 priority String @default("normal")
 dueAt DateTime?
 assigneeId String?
 creatorId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
 creator User @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
 @@index([assigneeId, status])
}
model StaffReport {
 id String @id @default(cuid())
 title String
 body String
 category String @default("general")
 status String @default("open")
 authorId String
 createdAt DateTime @default(now())
 author User @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
 @@index([status, createdAt])
}
model MemberAchievement {
 id String @id @default(cuid())
 userId String
 key String
 title String
 description String
 awardedAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([userId, key])
}
